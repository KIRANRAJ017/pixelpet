{
  "name": "pixel-pet",
  "version": "1.0.0",
  "description": "A cute pixel-art companion that lives on your Windows desktop",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "electron .",
    "dev": "vite",
    "build:renderer": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:web": "npm run build:renderer && node scripts/prepare-dist.js",
    "build": "node scripts/build.js",
    "test": "vitest run",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [
    "pixel-pet",
    "desktop-pet",
    "electron",
    "react",
    "pixel-art"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/KIRANRAJ017/pixelpet.git"
  },
  "homepage": "https://kiranraj017.github.io/pixelpet/",
  "author": "Kiran Raj",
  "license": "MIT",
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
